---
interface Props {
  heading: string;
  quote: string;
}

const { heading, quote } = Astro.props;
---

<aside class="character-callout" aria-label={heading}>
  <img
    src="/images/mohamed-explaining-badge.webp"
    alt="Illustrated portrait of Mohamed pointing to an engineering note"
    width="72"
    height="72"
    loading="lazy"
    decoding="async"
    class="callout-avatar"
  />
  <div class="callout-body">
    <p class="eyebrow callout-eyebrow">Mohamed’s Engineering Note · {heading}</p>
    <p class="callout-quote">“{quote}”</p>
  </div>
</aside>

<style>
  .character-callout {
    display: flex;
    align-items: flex-start;
    gap: 1.15rem;
    padding: 1.25rem 1.4rem;
    margin-block: 2rem;
    background: var(--surface-paper);
    border: 1.5px solid var(--border-subtle);
    border-left: 4px solid var(--teal);
    border-radius: var(--radius-md);
  }

  .callout-avatar {
    width: 72px;
    height: 72px;
    border-radius: 999px;
    flex-shrink: 0;
    background: var(--bg-ivory);
  }

  .callout-eyebrow {
    margin: 0 0 0.35rem;
  }

  .callout-quote {
    margin: 0;
    font-size: 0.98rem;
    color: var(--ink);
  }

  @media (max-width: 560px) {
    .character-callout {
      flex-direction: column;
      gap: 0.75rem;
    }

    .callout-avatar {
      width: 56px;
      height: 56px;
    }
  }
</style>
