---
import { SITE_META } from '../data/portfolio';
---
<footer id="contact" class="site-footer">
  <div class="container">
    <p class="kicker">Contact</p>
    <div class="contact-grid">
      <div><h2>Let’s talk<span>.</span></h2>
        <a class="email" href={`mailto:${SITE_META.email}`}>{SITE_META.email} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="links">
        <a href={SITE_META.github}>GitHub <span aria-hidden="true">↗</span></a>
        <a href={SITE_META.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a>
        <a href={SITE_META.cvUrl} download>Download CV (PDF) <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <div class="colophon"><span>{SITE_META.name} · {SITE_META.role}</span><span>{SITE_META.location}</span></div>
  </div>
</footer>
<style>
  .site-footer { background:#252923; color:var(--surface-paper); padding:var(--section-space) 0 1.5rem; }
  .kicker { color:var(--peach); margin:0 0 1rem; }
  .contact-grid { display:grid; grid-template-columns:1.6fr 1fr; align-items:end; gap:2rem; }
  h2 { margin:0 0 1rem; font-weight:580; letter-spacing:-.075em; font-size:clamp(3.7rem,8vw,7.5rem); line-height:.95; }
  h2 span { color:var(--peach); }
  a { color:inherit; text-decoration:none; }
  a:hover { color:var(--peach); }
  a:focus-visible { outline-color:var(--peach); }
  .email { display:inline-block; font-size:clamp(1rem,2.1vw,1.65rem); overflow-wrap:anywhere; border-bottom:1px solid #abae9e; }
  .links { display:grid; }
  .links a { display:flex; align-items:center; justify-content:space-between; min-height:44px; border-bottom:1px solid #565c51; }
  .links a span { color:var(--peach); }
  .colophon { margin-top:clamp(2.5rem,5vw,5rem); border-top:1px solid #565c51; padding-top:1rem; display:flex; justify-content:space-between; flex-wrap:wrap; gap:.5rem; font:400 .72rem/1.5 var(--font-mono); color:#d3d4c9; }
  @media(max-width:700px) { .contact-grid { grid-template-columns:1fr; } }
</style>
