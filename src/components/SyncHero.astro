---
import { SITE_META } from '../data/portfolio';

const [givenName, ...familyNames] = SITE_META.name.split(' ');

// A short tone burst on a silent illustrative timeline, drawn at build time.
const samples = Array.from({ length: 157 }, (_, i) => {
  const envelope = i < 9 ? i / 9 : Math.exp(-(i - 9) / 28);
  const y = 20 - Math.sin(i * 1.32) * 16 * envelope;
  return i + ',' + y.toFixed(1);
}).join(' ');
---

<section class="hero container" aria-labelledby="hero-heading">
  <div class="intro">
    <p class="kicker"><span class="signal-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span> Media systems / Backend / AI</p>
    <h1 id="hero-heading" aria-label={SITE_META.name}>{givenName}<br />{familyNames.join(' ')}<span>.</span></h1>
    <p class="role">{SITE_META.role} at <strong>Spokn</strong></p>
    <p class="lead">{SITE_META.heroLead}</p>
    <div class="hero-actions">
      <a class="btn btn--primary" href="#work">Explore my work <span aria-hidden="true">↓</span></a>
      <a class="text-action" href="#contact">Get in touch <span aria-hidden="true">↗</span></a>
    </div>
    <p class="location mono"><svg width="14" height="16" viewBox="0 0 16 18" fill="none" aria-hidden="true"><path d="M14 7c0 4-6 10-6 10S2 11 2 7a6 6 0 1112 0Z" stroke="currentColor" stroke-width="1.5"/><circle cx="8" cy="7" r="2" stroke="currentColor" stroke-width="1.5"/></svg>{SITE_META.location}</p>
  </div>

  <figure class="instrument" data-sync-stage data-state="drift">
    <div class="monitor-head"><strong><i aria-hidden="true"></i> Sync monitor</strong><span>Silent demo</span></div>
    <div class="frame">
      <div class="rings" aria-hidden="true"></div>
      <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
      <span class="frame-label">V1 / Picture</span>
      <img src="/images/mohamed-welcoming.webp" width="520" height="660" alt="Illustrated portrait of Mohamed waving" fetchpriority="high" data-pose />
      <span class="timecode">Flash / 00:00:01.000</span>
    </div>
    <div class="scope">
      <div class="scope-label"><span>A1 / Audio</span><span>1 kHz</span></div>
      <div class="trace" aria-hidden="true">
        <svg viewBox="0 0 400 40" preserveAspectRatio="none"><line x1="0" x2="400" y1="20" y2="20"/><g class="wave"><polyline points={samples} /></g></svg>
        <span class="needle"></span><span class="sweep"></span>
      </div>
    </div>
    <figcaption>
      <span class="readout" role="status"><b data-offset>+120 ms</b><small data-caption>Audio trails picture</small></span>
      <div class="controls" data-demo-controls hidden>
        <button type="button" class="align" data-toggle>Align cues <span aria-hidden="true">→</span></button>
        <button type="button" class="replay" data-replay aria-label="Replay silent timeline" title="Replay silent timeline">↻</button>
      </div>
      <noscript>The flash and beep coincide when the offset reaches 0 ms.</noscript>
    </figcaption>
  </figure>
</section>

<script>
  const stage = document.querySelector<HTMLElement>('[data-sync-stage]')!;
  const toggle = stage.querySelector<HTMLButtonElement>('[data-toggle]')!;
  const portrait = stage.querySelector<HTMLImageElement>('[data-pose]')!;
  const sweep = stage.querySelector<HTMLElement>('.sweep')!;
  const replay = () => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    sweep.animate([{left: '0%', opacity: .9}, {left: '100%', opacity: 0}], {duration: 700});
  };
  toggle.addEventListener('click', () => {
    const aligned = stage.dataset.state === 'drift';
    stage.dataset.state = aligned ? 'aligned' : 'drift';
    stage.querySelector('[data-offset]')!.textContent = aligned ? '0 ms' : '+120 ms';
    stage.querySelector('[data-caption]')!.textContent = aligned ? 'Sound and picture align' : 'Audio trails picture';
    toggle.firstChild!.textContent = aligned ? 'Restore lag ' : 'Align cues ';
    portrait.src = aligned ? '/images/mohamed-explaining.webp' : '/images/mohamed-focused.webp';
    portrait.alt = aligned ? 'Mohamed pointing to the aligned cues' : 'Mohamed studying the timing offset';
    replay();
  });
  stage.querySelector('[data-replay]')!.addEventListener('click', replay);
  stage.querySelector('[data-demo-controls]')!.removeAttribute('hidden');
</script>

<style>
  .hero { display:grid; grid-template-columns:1fr minmax(0,.95fr); align-items:center; gap:clamp(2rem,7vw,7rem); padding-block:clamp(2.8rem,5vw,5.3rem); }
  .kicker { display:flex; align-items:center; gap:.65rem; margin:0 0 1.35rem; }
  h1 { font-size:clamp(4.2rem,7.9vw,7.9rem); line-height:.86; letter-spacing:-.065em; font-weight:650; margin:0 0 1.7rem -.05em; }
  h1 span { color:var(--orange); }
  @media (prefers-reduced-motion:no-preference) {
    h1 { animation:title-in 380ms ease-out; }
    @keyframes title-in { from { transform:translateY(6px); opacity:.65; } }
  }
  .role { font-size:clamp(1.16rem,1.6vw,1.48rem); letter-spacing:-.035em; margin:0 0 .6rem; }
  .lead { max-width:31rem; margin:0; color:var(--ink-muted); line-height:1.55; }
  .hero-actions { display:flex; align-items:center; flex-wrap:wrap; gap:1.5rem; margin-top:1.5rem; }
  .text-action { color:var(--ink); font-weight:600; font-size:.93rem; text-decoration:none; border-bottom:1px solid var(--ink); padding:.55rem 0 .25rem; }
  .text-action span { margin-left:.4rem; }
  .location { display:flex; align-items:center; gap:.45rem; font-size:.75rem; color:var(--ink-muted); margin:1.65rem 0 0; }
  .instrument { min-width:0; margin:0; background:#242622; color:#f4f1e9; border-radius:8px; overflow:hidden; border:1px solid #262721; box-shadow:5px 6px 0 #d8d5cb; }
  .monitor-head,.scope-label,.frame-label,.timecode { font:500 .68rem/1.2 var(--font-mono); letter-spacing:.075em; text-transform:uppercase; }
  .monitor-head,.scope-label,figcaption { display:flex; align-items:center; justify-content:space-between; gap:.7rem; }
  .monitor-head { padding:.9rem 1.1rem; color:#d9d8cf; }
  .monitor-head strong { display:flex; align-items:center; gap:.55rem; color:white; font-weight:500; }
  .monitor-head i { width:.55rem; height:.55rem; border-radius:50%; background:var(--peach); }
  .frame { position:relative; isolation:isolate; overflow:hidden; aspect-ratio:1.95; background-color:#edac87; background-image:radial-gradient(#8b5b403d .8px,transparent .9px); background-size:5px 5px; }
  .rings { position:absolute; left:50%; top:57%; width:61%; aspect-ratio:1; border-radius:50%; transform:translate(-50%,-50%); background:#f3bf9e; border:1px solid #9260407a; box-shadow:0 0 0 14px #efb391,0 0 0 15px #92604060,0 0 0 31px #eeae8900,0 0 0 32px #92604050; }
  .frame img { position:absolute; height:122%; width:auto; max-width:74%; object-fit:contain; object-position:top; top:7%; left:50%; transform:translateX(-50%); }
  .corner { --edge:1.5px solid #714e39; width:12px; height:12px; position:absolute; }
  .tl,.bl { left:12px; border-left:var(--edge); } .tr,.br { right:12px; border-right:var(--edge); }
  .tl,.tr { top:12px; border-top:var(--edge); } .bl,.br { bottom:12px; border-bottom:var(--edge); }
  .frame-label,.timecode { position:absolute; color:#472f21; font-size:.65rem; }
  .frame-label { top:18px; left:22px; } .timecode { right:21px; bottom:17px; background:#f2ba96; padding:3px; }
  .scope { padding:.7rem 1.1rem .35rem; }
  .scope-label { color:#d2d3c9; font-size:.63rem; }
  .trace { height:45px; position:relative; overflow:hidden; background:repeating-linear-gradient(90deg,transparent 0 calc(5% - 1px),#ddddcc12 calc(5% - 1px) 5%); }
  .trace svg { width:100%; height:100%; stroke:#e5cf9b; fill:none; stroke-width:1.3; }
  .trace line { stroke:#b4a27d; stroke-width:.65; }
  .wave { transform:translateX(55%); transition:transform var(--motion-slow) ease; }
  [data-state="aligned"] .wave { transform:translateX(40%); }
  .needle,.sweep { position:absolute; inset-block:0; width:1px; }
  .needle { left:40%; background:var(--peach); } .needle::before { content:''; display:block; width:7px; height:6px; background:var(--peach); transform:translateX(-3px); clip-path:polygon(0 0,100% 0,50% 100%); }
  .sweep { opacity:0; background:white; }
  figcaption { border-top:1px solid #ffffff30; padding:.65rem 1.1rem; }
  .readout { display:grid; } .readout b { color:var(--peach); font:500 1rem/1.3 var(--font-mono); } .readout small { color:#d2d3c9; font-size:.77rem; }
  .controls { display:flex; gap:.4rem; }
  .controls button { min-height:44px; padding:.6rem .85rem; border-radius:4px; border:1px solid #76786f; font:600 .8rem/1.2 var(--font-sans); cursor:pointer; }
  .align { background:#f0eee5; color:#242622; } .align span { margin-left:.4rem; } .replay { background:transparent; color:white; }
  .controls button:hover { background:var(--peach); color:#242622; }
  .controls :focus-visible { outline-color:var(--peach); }
  @media(max-width:760px) {
    .hero { grid-template-columns:1fr; gap:2rem; }
    h1 { font-size:clamp(4.25rem,13vw,6rem); }
    .instrument { width:100%; max-width:36rem; }
    .location { margin-top:1rem; }
  }
  @media(max-width:390px) {
    figcaption,.monitor-head { padding-inline:.7rem; } .controls button { padding-inline:.55rem; }
    .frame-label,.timecode { font-size:.56rem; }
  }
</style>
