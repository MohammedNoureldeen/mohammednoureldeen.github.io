---
import { SITE_META } from '../data/portfolio';
const home = Astro.url.pathname === '/' ? '' : '/';
const sections = [
  ['work', 'Work'], ['about', 'About'], ['experience', 'Experience'], ['skills', 'Skills'],
  ['open-source', 'Open source'], ['contact', 'Contact'],
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Mohamed Ali Rafat — Home">
      <span class="brand-logo" aria-hidden="true">m<span>/</span></span>
      {SITE_META.name}
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="section-links">Menu</button>
      <ul id="section-links" class="nav-list">
        {sections.map(([id, title]) => <li><a href={home + '#' + id}>{title}</a></li>)}
      </ul>
    </nav>
    <a href={SITE_META.cvUrl} download="Mohamed_Ali_Rafat_CV.pdf" class="btn btn--sm header-cv" aria-label="Download CV (PDF)">
      <span class="cv-long">Download </span>CV <span aria-hidden="true">↓</span>
    </a>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const menu = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  if (header && menu) {
    const close = () => menu.setAttribute('aria-expanded', 'false');
    header.dataset.ready = '';
    menu.addEventListener('click', () => {
      menu.setAttribute('aria-expanded', String(menu.getAttribute('aria-expanded') === 'false'));
    });
    header.querySelector('.nav-list')?.addEventListener('click', (event) => {
      const link = event.target instanceof Element && event.target.closest('a');
      if (!link) return;
      close();
      if (link.pathname === location.pathname) {
        const section = document.getElementById(link.hash.slice(1));
        section?.setAttribute('tabindex', '-1');
        section?.focus({ preventScroll: true });
      }
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.getAttribute('aria-expanded') === 'true') {
        close();
        menu.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !header.contains(event.target)) close();
    });
    header.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && !header.contains(event.relatedTarget)) close();
    });
    matchMedia('(max-width: 64rem)').addEventListener('change', close);
    new ResizeObserver(() => {
      document.documentElement.style.setProperty('--header-height', header.offsetHeight + 'px');
    }).observe(header);
  }
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--bg-ivory); border-bottom: 1px solid var(--border-subtle); }
  .header-inner, .brand, .nav-list { display: flex; align-items: center; }
  .header-inner { gap: 1.25rem; min-height: 4.35rem; }
  .brand { margin-right: auto; gap: .65rem; font-weight: 650; line-height: 1.2; }
  .brand, .nav-list a { color: var(--ink); text-decoration: none; }
  .brand-logo { background:var(--ink); color:var(--surface-paper); display:inline-flex; align-items:center; justify-content:center; width:2.15rem; height:2.15rem; border-radius:4px; font-size:1.5rem; font-weight:650; letter-spacing:-.12em; padding-right:.12em; }
  .brand-logo span { color:var(--peach); font-size:1.4rem; }
  .nav-list { gap: 1rem; list-style: none; padding: 0; margin: 0; }
  .nav-list a { display: block; padding: .45rem 0; font-size: .86rem; font-weight: 500; }
  .nav-list a:hover, .brand:hover { color: var(--teal); text-decoration: underline; }
  .header-cv { display: inline-block; white-space: nowrap; border:1px solid var(--border-subtle); background:transparent; color:var(--ink); }
  .header-cv:hover { background: var(--ink); color:white; }
  .menu-toggle { display: none; }
  @media (max-width: 64rem) {
    .site-header { position: static; }
    .site-header[data-ready] { position: sticky; }
    .header-inner { min-height: 3.5rem; gap: .65rem; flex-wrap: wrap; padding-block: .35rem; }

    .site-nav { order: 1; width: 100%; }
    .nav-list { flex-wrap: wrap; gap: .25rem 1rem; }
    [data-ready] .site-nav { order: initial; width: auto; }
    [data-ready] .menu-toggle { display: block; min-height: 44px; padding: .4rem .6rem; border: 0; background: transparent; font: inherit; font-weight: 600; color: var(--teal); cursor: pointer; }
    [data-ready] .nav-list { display: none; position: absolute; inset: 100% 0 auto; background: var(--surface-paper); padding: .5rem max(1.15rem, 4vw); border-bottom: 1px solid var(--border-subtle); box-shadow: 0 8px 16px #20252114; max-height: 70vh; overflow-y: auto; }
    [data-ready] .menu-toggle[aria-expanded='true'] + .nav-list { display: block; }
    .nav-list a { padding: .6rem 0; }
    .header-cv { padding: .65rem .8rem; }
  }
  @media (max-width: 30rem) {
    .cv-long { display: none; }
    .header-inner { gap: .3rem; }
  }
</style>
