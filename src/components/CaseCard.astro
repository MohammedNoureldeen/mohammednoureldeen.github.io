---
interface Props {
  slugId: 'audio-video-sync' | 'transcript-timing-correction' | 'ordered-story-approvals';
  title: string;
  cardSummary: string;
}

const { slugId, title, cardSummary } = Astro.props;
const href = `/work/${slugId}/`;
---

<article class="case-card">
  <div class="card-top">
    <!-- Custom Labeled Editorial Schematic Motif per Case -->
    <div class="card-schematic" aria-hidden="true">
      {slugId === 'audio-video-sync' && (
        <svg viewBox="0 0 280 68" fill="none">
          <rect width="280" height="68" rx="8" fill="#181D1A" />
          <line x1="140" y1="8" x2="140" y2="60" stroke="#2DD4BF" stroke-width="2" />
          <text x="14" y="25" fill="#A6B3AA" font-family="monospace" font-size="10">V1 FLASH</text>
          <rect x="131" y="13" width="18" height="16" rx="3" fill="#2DD4BF" />
          <text x="14" y="51" fill="#A6B3AA" font-family="monospace" font-size="10">A1 BEEP</text>
          <rect x="131" y="39" width="18" height="16" rx="3" stroke="#2DD4BF" stroke-width="1.5" />
          <rect x="196" y="39" width="18" height="16" rx="3" fill="#FBBF24" fill-opacity="0.35" stroke="#FBBF24" />
          <path d="M190 47H155M155 47l5-4M155 47l5 4" stroke="#2DD4BF" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      )}
      {slugId === 'transcript-timing-correction' && (
        <svg viewBox="0 0 280 68" fill="none">
          <rect width="280" height="68" rx="8" fill="#EDE7D9" />
          <rect x="12" y="12" width="118" height="22" rx="5" fill="#FCFAF5" stroke="#006B65" stroke-width="1.5" />
          <text x="20" y="27" fill="#006B65" font-family="monospace" font-size="10" font-weight="bold">"Spokn" ✓ [04.12s]</text>
          <rect x="142" y="12" width="126" height="22" rx="5" fill="#FCFAF5" stroke="#D2CBBD" />
          <text x="150" y="27" fill="#49504B" font-family="monospace" font-size="10">"spoken"  [06.80s]</text>
          <text x="14" y="53" fill="#202521" font-family="monospace" font-size="9.5">TIMESTAMPS IMMUTABLE · FALLBACK READY</text>
        </svg>
      )}
      {slugId === 'ordered-story-approvals' && (
        <svg viewBox="0 0 280 68" fill="none">
          <rect width="280" height="68" rx="8" fill="#EDE7D9" />
          <rect x="14" y="18" width="72" height="32" rx="6" fill="#006B65" />
          <text x="24" y="38" fill="#FCFAF5" font-family="monospace" font-size="10" font-weight="bold">1. READY</text>
          <path d="M91 34h12" stroke="#202521" stroke-width="1.6" />
          <rect x="108" y="18" width="74" height="32" rx="6" fill="#FCFAF5" stroke="#006B65" stroke-width="1.5" />
          <text x="117" y="38" fill="#006B65" font-family="monospace" font-size="10" font-weight="bold">2. ACTIVE</text>
          <path d="M187 34h12" stroke="#49504B" stroke-width="1.5" stroke-dasharray="3 2" />
          <rect x="204" y="18" width="62" height="32" rx="6" fill="#FCFAF5" stroke="#D2CBBD" />
          <text x="213" y="38" fill="#49504B" font-family="monospace" font-size="10">3. LOCK</text>
        </svg>
      )}
    </div>

    <h3 class="card-title">
      <a href={href}>{title}</a>
    </h3>

    <p class="card-summary">{cardSummary}</p>
  </div>

  <a href={href} class="card-link" aria-label={`Read case study: ${title}`}>
    Read case study <span aria-hidden="true">→</span>
  </a>
</article>

<style>
  .case-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--surface-paper);
    border: 1.5px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: clamp(1rem, 2vw, 1.45rem);
    transition: border-color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
  }

  .case-card:hover {
    border-color: var(--teal);
    box-shadow: 0 10px 24px rgba(32, 37, 33, 0.06);
  }

  .card-schematic {
    margin-bottom: 1rem;
    border-radius: 8px;
    overflow: hidden;
  }

  .card-schematic svg {
    width: 100%;
    height: auto;
  }

  .card-title {
    font-size: 1.28rem;
    line-height: 1.28;
    margin: 0 0 0.65rem;
  }

  .card-title a {
    color: var(--ink);
    text-decoration: none;
  }

  .card-title a:hover {
    color: var(--teal);
    text-decoration: underline;
  }

  .card-summary {
    color: var(--ink-muted);
    font-size: 0.96rem;
    margin: 0 0 .85rem;
  }

  .card-link {
    align-self: flex-start;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
  }

  .card-link:hover {
    text-decoration: underline;
  }
</style>
