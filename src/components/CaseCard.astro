---
interface Props {
  slugId: 'audio-video-sync' | 'transcript-timing-correction' | 'ordered-story-approvals';
  title: string;
  cardSummary: string;
}

const { slugId, title, cardSummary } = Astro.props;
const href = `/work/${slugId}/`;
const previews = {
  'audio-video-sync': {
    label: 'Sync monitor', before: 'Audio arrives 120 ms late', after: 'Aligned · 0 ms apart',
  },
  'transcript-timing-correction': {
    label: 'Transcript editor', before: 'Two occurrences of “spoken”', after: 'Name corrected · timing preserved',
  },
  'ordered-story-approvals': {
    label: 'Review queue', before: 'Editorial has the story', after: 'Editorial approved · review unlocked',
  },
};
const preview = previews[slugId];
---

<article class="case-card" data-case-preview data-state="complete">
  <div class="screen" data-project={slugId} aria-hidden="true">
    <div class="monitor-label">{preview.label}<i></i></div>
    {slugId === 'audio-video-sync' && (
      <div class="tracks">
        <div class="cue picture"></div><div class="cue sound"></div>
      </div>
    )}
    {slugId === 'transcript-timing-correction' && (
      <div class="transcript">
        <div class="word"><small>04.12s</small><b><span class="before">spoken</span><span class="after">Spokn</span></b></div>
        <div class="word"><small>06.80s</small><b>spoken</b></div>
      </div>
    )}
    {slugId === 'ordered-story-approvals' && (
      <div class="steps"><span class="editorial">Editorial</span><i>→</i><span class="review">Review</span><i>→</i><span>Sign-off</span></div>
    )}
    <div class="readout"><span class="before">{preview.before}</span><span class="after">{preview.after}</span></div>
  </div>

  <div class="card-body">
    <h3><a href={href}>{title}</a></h3>
    <p>{cardSummary}</p>
    <div class="actions">
      <button type="button" hidden aria-label={`Preview ${title}`}>
        <span aria-hidden="true">▷</span> Preview
      </button>
      <a href={href} aria-label={`Read case study: ${title}`}>Case study <span aria-hidden="true">→</span></a>
    </div>
    <span class="sr-only" role="status" data-result={preview.after}></span>
  </div>
</article>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-case-preview]').forEach((card) => {
    const button = card.querySelector('button')!;
    const status = card.querySelector<HTMLElement>('[role="status"]')!;
    let timer: number | undefined;

    function reset() {
      window.clearTimeout(timer);
      card.dataset.state = reducedMotion.matches ? 'complete' : 'ready';
      status.textContent = '';
    }

    function play(announce = false) {
      reset();
      const finish = () => {
        card.dataset.state = 'complete';
        if (announce) status.textContent = status.dataset.result!;
      };
      if (reducedMotion.matches) finish();
      else timer = window.setTimeout(finish, 450);
    }

    reset();
    button.hidden = false;
    reducedMotion.addEventListener('change', reset);
    card.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse') play();
    });
    card.addEventListener('focusin', (event) => {
      if (event.target instanceof HTMLElement && event.target.matches(':focus-visible') &&
          !card.contains(event.relatedTarget as Node | null)) play();
    });
    button.addEventListener('click', () => play(true));
  });
</script>

<style>
  .case-card {
    min-width: 0;
    display: grid;
    grid-template-rows: auto 1fr;
    padding: .75rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-paper);
  }

  .case-card:is(:hover, :focus-within) { border-color: var(--teal); }
  .screen {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: .7rem;
    padding: 1rem;
    border-radius: var(--radius-md);
    aspect-ratio: 1.85;
    font: .75rem/1.3 var(--font-mono);
  }

  [data-project="audio-video-sync"] { background: #152e2a; color: #cefff0; }
  [data-project="transcript-timing-correction"] { background: #dde9cc; color: #344238; }
  [data-project="ordered-story-approvals"] { background: #f4d8c6; color: #572e22; }
  .monitor-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: .68rem;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .monitor-label i { width: .45rem; height: .45rem; border-radius: 50%; background: currentColor; }
  .tracks {
    position: relative;
    height: 3.8rem;
    border-block: 1px solid #ffffff33;
    background: repeating-linear-gradient(90deg, transparent 0 9.5%, #ffffff18 9.5% 10%);
  }
  .tracks::before { content: ''; position: absolute; inset-block: 0; left: 42%; border-left: 1px dashed #b9ffdb; }
  .cue { position: absolute; left: 42%; width: 24%; height: .65rem; border-radius: 2px; }
  .picture { top: 20%; background: #85eec3; }
  .sound { top: 63%; background: repeating-linear-gradient(90deg, #e6b366 0 2px, #996a38 2px 4px); }
  [data-state="ready"] .sound { left: 65%; }
  [data-state="complete"] .sound { transition: left 500ms ease-in-out; }

  .word { display: flex; align-items: center; gap: .75rem; }
  .word + .word { margin-top: .35rem; padding-top: .35rem; border-top: 1px solid #aebea2; }
  .word small { font-size: .7rem; }
  .word b { font: 500 1.32rem/1.2 var(--font-sans); }
  .word .after { color: #006347; text-decoration: underline; text-underline-offset: .16em; }
  [data-state="complete"] .word .after { animation: ink-in 320ms ease-out; }
  @keyframes ink-in { from { opacity: .35; } to { opacity: 1; } }

  .steps { display: flex; align-items: center; justify-content: space-between; gap: .2rem; }
  .steps span { padding: .45rem .35rem; border: 1px solid #a77f70; border-radius: 5px; }
  .steps i { font-style: normal; }
  [data-state="ready"] .editorial, [data-state="complete"] .review { color: white; background: #653a2c; }
  [data-state="complete"] .editorial { background: #e7bda6; }
  [data-state="complete"] .steps span { transition: background-color 320ms, color 320ms; }
  [data-state="complete"] .before, [data-state="ready"] .after { display: none; }

  .card-body { display: flex; flex-direction: column; min-width: 0; padding: 1rem .25rem 0; }
  h3 { margin: 0; font-size: 1.4rem; letter-spacing: -.035em; line-height: 1.15; }
  h3 a { color: var(--ink); text-decoration: none; }
  p { margin: .55rem 0 1rem; font-size: .96rem; line-height: 1.45; color: var(--ink-muted); }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: .25rem .6rem;
    margin-top: auto;
    padding-top: .5rem;
    border-top: 1px solid var(--border-subtle);
  }
  button, .actions a { font: 600 .86rem/1.2 var(--font-sans); }
  button {
    padding: .48rem .68rem;
    color: var(--ink);
    background: transparent;
    border: 1px solid #a9b6aa;
    border-radius: 2rem;
    cursor: pointer;
  }
  button:hover { background: var(--teal-soft); }
  .actions a { display: inline-flex; align-items: center; gap: .3em; min-height: 2.5rem; text-decoration: none; }
  a:hover { text-decoration: underline; }

  @media (max-width: 980px) {
    .case-card { grid-template: auto / clamp(4.6rem, 23vw, 11rem) minmax(0, 1fr); align-items: center; gap: .75rem; }
    .screen { justify-content: center; aspect-ratio: auto; min-height: 6.1rem; padding: .5rem; }
    .monitor-label, .readout, .steps i { display: none; }
    .word { flex-direction: column; align-items: start; gap: 0; }
    .word small { font-size: .61rem; }
    .word b { font-size: 1rem; }
    .steps { display: grid; justify-content: stretch; }
    .steps span { font-size: .66rem; padding: .1rem .32rem; }
    .card-body { padding: 0; }
    h3 { font-size: 1.15rem; }
    p { margin: .3rem 0; font-size: .86rem; }
    .actions { justify-content: flex-start; border: 0; padding: 0; }
    button, .actions a { font-size: .78rem; }
  }

  @media (max-width: 370px) {
    .case-card { grid-template-columns: 5rem minmax(0, 1fr); padding: .55rem; gap: .55rem; }
    .screen { padding-inline: .3rem; }
  }
</style>
