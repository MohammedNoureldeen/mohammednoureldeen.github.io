---
interface Props {
  slugId: 'audio-video-sync' | 'transcript-timing-correction' | 'ordered-story-approvals';
  title: string;
  cardSummary: string;
  stack: string[];
}
const { slugId, title, cardSummary, stack } = Astro.props;
const href = `/work/${slugId}/`;
const previews = {
  'audio-video-sync': { label:'Media systems', before:'Offset +120 ms', after:'Aligned · 0 ms' },
  'transcript-timing-correction': { label:'Applied AI', before:'Original transcript', after:'Timestamps preserved' },
  'ordered-story-approvals': { label:'Backend workflows', before:'Editorial in progress', after:'Review unlocked' },
};
const preview = previews[slugId];
---

<article class="case-card" data-case-preview data-state="complete">
  <div class="screen" data-project={slugId} aria-hidden="true">
    <span class="monitor-label">{preview.label}</span>
    {slugId === 'audio-video-sync' && (
      <div class="tracks">
        <div class="track"><small>V1</small><div class="lane"><i class="film"></i></div></div>
        <div class="track"><small>A1</small><div class="lane"><i class="tone"></i></div></div>
      </div>
    )}
    {slugId === 'transcript-timing-correction' && (
      <div class="transcript">
        <span class="token"><small>04.12 s</small><b class="before">spoken</b><b class="after">Spokn</b></span>
        <span class="token"><small>06.80 s</small><b>spoken</b></span>
      </div>
    )}
    {slugId === 'ordered-story-approvals' && (
      <div class="steps"><span class="editorial"><i></i>Editorial</span><b>→</b><span class="review"><i></i>Review</span><b>→</b><span><i></i>Sign-off</span></div>
    )}
    <span class="readout"><span class="before">{preview.before}</span><span class="after">{preview.after}</span></span>
  </div>
  <div class="card-body">
    <span class="tech mono">{stack.slice(0, 2).join(' / ')}</span>
    <h3><a href={href}>{title}</a></h3>
    <p>{cardSummary}</p>
    <div class="actions">
      <a href={href} aria-label={`Read case study: ${title}`}>Case study <span aria-hidden="true">↗</span></a>
      <button type="button" hidden aria-label={`Preview ${title}`}><span aria-hidden="true">▷</span> Preview</button>
    </div>
    <span class="sr-only" role="status" data-result={preview.after}></span>
  </div>
</article>
<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-case-preview]').forEach((card) => {
    const button = card.querySelector('button')!;
    const status = card.querySelector<HTMLElement>('[role="status"]')!;
    let timer: number | undefined;

    function reset() {
      window.clearTimeout(timer);
      card.dataset.state = reducedMotion.matches ? 'complete' : 'ready';
      status.textContent = '';
    }

    function play(announce = false) {
      reset();
      const finish = () => {
        card.dataset.state = 'complete';
        if (announce) status.textContent = status.dataset.result!;
      };
      if (reducedMotion.matches) finish();
      else timer = window.setTimeout(finish, 450);
    }

    reset();
    button.hidden = false;
    reducedMotion.addEventListener('change', reset);
    card.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse') play();
    });
    card.addEventListener('focusin', (event) => {
      if (event.target instanceof HTMLElement && event.target.matches(':focus-visible') &&
          !card.contains(event.relatedTarget as Node | null)) play();
    });
    button.addEventListener('click', () => play(true));
  });
</script>


<style>
  .case-card { min-width:0; display:flex; flex-direction:column; }
  .screen { aspect-ratio:1.9; min-height:9rem; padding:1rem 1.1rem; display:grid; grid-template-rows:auto 1fr auto; gap:.5rem; align-items:center; position:relative; overflow:hidden; border-radius:5px; font:500 .68rem/1.3 var(--font-mono); }
  .monitor-label { justify-self:start; text-transform:uppercase; letter-spacing:.09em; }
  .readout { justify-self:end; font-size:.67rem; }
  [data-project="audio-video-sync"] { background:repeating-linear-gradient(90deg,transparent 0 calc(8.33% - 1px),#d5efe217 calc(8.33% - 1px) 8.33%),#28473e; color:#ecf4e8; }
  .tracks { display:grid; gap:4px; margin-inline:4%; }
  .track { display:flex; align-items:center; gap:.5rem; font-size:.7rem; }
  .lane { position:relative; flex:1; height:1.5rem; background:#172f29; }
  .lane i { position:absolute; top:3px; bottom:3px; width:52%; left:23%; }
  .film { background:repeating-linear-gradient(90deg,#cee2bf 0 13%,#66846d 13% 14.5%); border-block:3px dotted #63816a; }
  .tone { background:repeating-linear-gradient(90deg,#e7aa7c 0 2px,#885f42 2px 4px); }
  [data-state="ready"] .tone { left:44%; }
  [data-state="complete"] .tone { transition:left var(--motion-slow) ease; }
  [data-project="transcript-timing-correction"] { background-color:#d8cfe7; color:#41344d; background-image:repeating-linear-gradient(0deg,transparent 0 23px,#71587d12 23px 24px); }
  .transcript { display:flex; align-items:center; justify-content:center; gap:.6rem; }
  .token { display:grid; }
  .token small { margin-bottom:.18rem; }
  .token b { font:500 clamp(1.15rem,2.6vw,2.4rem)/1.2 var(--font-sans); padding:0 .2em; letter-spacing:-.05em; border:1px solid #9786a3; }
  .token:first-child b { background:#f1e9fa; border-color:#766183; }
  [data-project="ordered-story-approvals"] { background-color:#e8d39a; color:#4b3c1f; background-image:radial-gradient(#8e795541 .7px,transparent 1px); background-size:5px 5px; }
  .steps { display:flex; align-items:center; justify-content:center; gap:.35rem; }
  .steps span { display:grid; justify-items:center; align-content:center; gap:.35rem; font-size:.66rem; }
  .steps i { width:2rem; aspect-ratio:1; border-radius:50%; border:1.5px solid #705c33; background:#efdeb1; position:relative; }
  .steps b { font-size:1.2rem; margin-top:-1rem; }
  [data-state="ready"] .editorial i, [data-state="complete"] .review i { box-shadow:inset 0 0 0 4px #ebd69d; background:#594728; }
  [data-state="complete"] .editorial i::after { content:'✓'; position:absolute; inset:0; display:grid; place-items:center; font-size:1rem; }
  [data-state="complete"] .before,[data-state="ready"] .after { display:none; }
  .card-body { flex:1; display:flex; flex-direction:column; padding:.95rem 0 0; }
  .tech { color:var(--ink-muted); font-size:.69rem; }
  h3 { font-weight:600; font-size:clamp(1.25rem,1.8vw,1.65rem); line-height:1.2; letter-spacing:-.045em; margin:.4rem 0; }
  h3 a,.actions a { color:var(--ink); text-decoration:none; }
  h3 a:hover,.actions a:hover { color:var(--orange); text-decoration:underline; }
  p { margin:0 0 .9rem; color:var(--ink-muted); font-size:.95rem; max-width:35ch; }
  .actions { display:flex; justify-content:space-between; align-items:center; margin-top:auto; border-top:1px solid var(--border-subtle); }
  .actions a,.actions button { display:inline-flex; gap:.5rem; min-height:44px; align-items:center; font:600 .84rem var(--font-sans); }
  .actions button { background:none; border:0; padding:.5rem .25rem; color:var(--ink-muted); cursor:pointer; }
  .actions button:hover { color:var(--orange); }
  @media(max-width:760px) {
    .case-card { display:grid; grid-template-columns:minmax(6.6rem,32%) minmax(0,1fr); gap:1rem; padding-block:1rem; border-top:1px solid var(--border-subtle); }
    .screen { aspect-ratio:auto; min-height:100%; padding:.65rem; }
    .card-body { padding:0; }
    .monitor-label { font-size:.6rem; }
    .readout { font-size:.58rem; justify-self:start; }
    .transcript { flex-direction:column; align-items:start; gap:.25rem; }
    .token { display:flex; align-items:center; gap:.25rem; flex-wrap:wrap; }
    .token small { font-size:.54rem; }
    .steps { align-items:start; flex-direction:column; gap:.25rem; }
    .steps span { display:flex; align-items:center; }
    .steps i { width:1rem; } .steps b { display:none; }
    .actions { border:0; flex-wrap:wrap; }
    p { margin-bottom:.25rem; font-size:.88rem; }
  }
</style>
