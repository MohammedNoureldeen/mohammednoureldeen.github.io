---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CharacterCallout from '../../components/CharacterCallout.astro';
import HlsPipelineDiagram from '../../components/HlsPipelineDiagram.astro';
import TranscriptLab from '../../components/TranscriptLab.astro';
import ApprovalStepper from '../../components/ApprovalStepper.astro';
import { SITE_META } from '../../data/portfolio';

export async function getStaticPaths() {
  const allCases = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return allCases.map((entry, idx) => ({
    params: { slug: entry.data.slugId },
    props: {
      entry,
      nextEntry: allCases[(idx + 1) % allCases.length],
    },
  }));
}

const { entry, nextEntry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const pageTitle = `${d.title} — Case Study · Mohamed Ali Rafat`;
---

<BaseLayout
  title={pageTitle}
  description={d.subtitle}
  ogImage={d.ogImage}
  canonicalPath={`/work/${d.slugId}/`}
>
  <article class="case-page">
    <header class="case-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/#work">← Back to Selected Work</a>
          <span class="mono" aria-hidden="true">/</span>
          <span class="mono">Case Study 0{d.order}</span>
        </nav>

        <p class="kicker case-meta">{d.employer} / {d.role} / {d.period}</p>

        <h1 class="case-title">{d.title}</h1>
        <p class="case-subtitle">{d.subtitle}</p>

        <ul class="stack-row" aria-label="Technologies applied">
          {d.stack.map((tech) => (
            <li class="mono">{tech}</li>
          ))}
        </ul>

        <p class="case-decision">{d.decisionSummary}</p>
        {d.slugId === 'audio-video-sync' && (
          <a class="fixture-link" href="#a-timing-check-you-can-reproduce">See the measured results from a synthetic export →</a>
        )}

      </div>
    </header>

    <div class="container case-body-wrap">
      <nav class="contents" aria-label="Case study contents">
        <p class="kicker">In this case</p>
        <a href="#demo">Interactive example</a>
        {headings.filter(h => h.depth === 2).map(h => <a href={`#${h.slug}`}>{h.text}</a>)}
      </nav>
      <div class="case-prose">
        <div id="demo">
          {d.slugId === 'audio-video-sync' && <HlsPipelineDiagram />}
          {d.slugId === 'transcript-timing-correction' && <TranscriptLab />}
          {d.slugId === 'ordered-story-approvals' && <ApprovalStepper />}
        </div>
        <div class="markdown-content">
          <Content />
        </div>

        <CharacterCallout heading={d.calloutHeading} quote={d.calloutQuote} />

        <!-- Post-Case Navigation & CV Access -->
        <div class="case-next-bar">
          <div>
            <p class="mono next-kicker">NEXT ENGINEERING CASE STUDY</p>
            <a href={`/work/${nextEntry.data.slugId}/`} class="next-link">
              0{nextEntry.data.order} · {nextEntry.data.title} →
            </a>
          </div>
          <div class="next-actions">
            <a href="/#work" class="btn btn--secondary btn--sm">All Work</a>
            <a
              href={SITE_META.cvUrl}
              download="Mohamed_Ali_Rafat_CV.pdf"
              class="btn btn--primary btn--sm"
            >
              Download CV (PDF)
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .case-hero {
    padding-block: clamp(2rem, 4.5vw, 3.5rem);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--surface-paper);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.9rem;
    margin-bottom: 1.25rem;
    color: var(--ink-muted);
  }

  .breadcrumb a {
    font-weight: 600;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .case-meta { margin:0 0 1rem; }

  .case-title {
    max-width: 19ch;
    font-size: clamp(2.7rem, 5.7vw, 5.7rem);
    line-height: .99;
    letter-spacing: -.065em;
    font-weight: 600;
    margin: 0 0 0.85rem;
  }

  .case-subtitle {
    font-size: clamp(1.05rem, 1.6vw, 1.22rem);
    color: var(--ink-muted);
    margin: 0 0 1.35rem;
    max-width: 48rem;
  }

  .stack-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .stack-row li {
    font-size: 0.75rem;
    padding: 0.25rem 0.62rem;
    border-radius: 6px;
    background: var(--bg-ivory);
    border: 1px solid var(--border-subtle);
  }

  .case-decision {
    max-width: 45rem;
    margin: 1rem 0 0;
    padding-left: 1rem;
    border-left: 3px solid var(--teal);
  }

  .fixture-link { display: inline-block; margin-top: .75rem; }
  .markdown-content :global(table) { width: 100%; border-collapse: collapse; font-size: .9rem; margin: 1.25rem 0; }
  .markdown-content :global(th), .markdown-content :global(td) { padding: .5rem; border-bottom: 1px solid var(--border-subtle); vertical-align: top; }
  .markdown-content :global(th) { background: var(--surface-warm); }
  @media (max-width: 30rem) {
    .markdown-content :global(th), .markdown-content :global(td) { padding: .35rem; }
  }

  .case-body-wrap {
    padding-block: 2rem 3rem;
    display:grid;
    grid-template-columns:minmax(10rem,.52fr) minmax(0,1.48fr);
    gap:clamp(1.5rem,5vw,5rem);
  }

  .contents { align-self:start; position:sticky; top:calc(var(--header-height,4rem) + 2rem); display:grid; }
  .contents p { color:var(--ink-muted); }
  .contents a { border-top:1px solid var(--border-subtle); padding:.7rem 0; font-size:.9rem; }
  @media(max-width:760px) { .case-body-wrap { grid-template-columns:1fr; } .contents { position:static; } }
  .case-prose {
    width:100%; min-width:0;
    max-width: 760px;
    margin-inline: auto;
  }

  .markdown-content :global(h2) {
    font-size: clamp(1.35rem, 2.4vw, 1.65rem);
    line-height: 1.25;
    margin: 2.35rem 0 0.85rem;
    color: var(--ink);
    letter-spacing: -0.015em;
  }

  .markdown-content :global(p) {
    margin: 0 0 1.1rem;
    color: var(--ink);
    font-size: 1.03rem;
    line-height: 1.7;
  }

  .markdown-content :global(ul),
  .markdown-content :global(ol) {
    margin: 0 0 1.35rem;
    padding-left: 1.35rem;
    display: grid;
    gap: 0.6rem;
    font-size: 1rem;
    color: var(--ink);
  }

  .markdown-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 0.12rem 0.38rem;
    border-radius: 5px;
    background: var(--surface-warm);
  }

  .case-next-bar {
    margin-top: 3rem;
    padding: 1.4rem 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--surface-paper);
    border: 2px solid var(--ink);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .next-kicker {
    margin: 0 0 0.25rem;
    font-size: 0.72rem;
    color: var(--ink-muted);
  }

  .next-link {
    font-size: 1.1rem;
    font-weight: 700;
    text-decoration: none;
  }

  .next-link:hover {
    text-decoration: underline;
  }

  .next-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

</style>
