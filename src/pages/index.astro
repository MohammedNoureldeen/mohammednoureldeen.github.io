---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SyncHero from '../components/SyncHero.astro';
import CaseCard from '../components/CaseCard.astro';
import { EXPERIENCE_ROLES, SKILLS_IN_PRACTICE, PUBLIC_CODE_SAMPLES, EDUCATION_AND_RECOGNITION } from '../data/portfolio';

const cases = (await getCollection('work')).sort((a,b) => a.data.order - b.data.order);
---

<BaseLayout title="Mohamed Ali Rafat · Software Engineer — Video Systems, Backend & Applied AI" description="Mohamed Ali Rafat is a software engineer in Giza, Egypt. Explore his work on video exports, backend workflows and timing-safe AI at Spokn." canonicalPath="/">
  <SyncHero />
  <section class="section work" id="work" aria-labelledby="work-heading">
    <div class="container">
      <header class="section-header"><h2 id="work-heading" class="section-title">Selected work<span>.</span></h2><p class="kicker">Engineering case studies / Spokn</p></header>
      <div class="cases-grid">
        {cases.map(({data}) => <CaseCard slugId={data.slugId} title={data.shortTitle} cardSummary={data.cardSummary} stack={data.stack} />)}
      </div>
    </div>
  </section>

  <section id="about" class="section about" aria-labelledby="about-heading">
    <div class="container split">
      <h2 class="kicker side-heading" id="about-heading">About me</h2>
      <div>
        <p class="story-title">From transaction data<br />to video timelines<span>.</span></p>
        <p class="story">At Sanam, I worked with messy merchant names and transaction descriptions. Today at Spokn, I work with the details of video editing. That might be the word that needs correcting, the reviewer whose turn comes next, or the sound that lands a fraction of a second late.</p>
        <p class="story">I check what happens in the finished file. For a video export, that can be as simple as putting a flash and a beep in a clip and measuring where they land.</p>
      </div>
    </div>
  </section>

  <section id="experience" class="section container career" aria-labelledby="experience-heading">
    <header class="section-header"><h2 class="section-title" id="experience-heading">Experience</h2></header>
    <div class="role-list">
      {EXPERIENCE_ROLES.map((job) => (
        <article class="role-row">
          <div class="role-meta"><p class="mono">{job.period}</p><span>{job.location}</span></div>
          <div class="role-body">
            <h3>{job.role}</h3><p class="employer">{job.company}</p>
            <p>{job.summary}</p>
            <details><summary>Contributions <span aria-hidden="true"></span></summary>
              <p class="kicker">{job.categoryLabel}</p>
              <ul>{job.highlights.map(item => <li>{item}</li>)}</ul>
              {job.relatedCaseLinks && <div class="related">{job.relatedCaseLinks.map(link => <a href={link.href}>{link.label} →</a>)}</div>}
            </details>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="skills" class="section skills" aria-labelledby="skills-heading">
    <div class="container">
      <header class="section-header"><h2 class="section-title" id="skills-heading">Technical toolkit</h2></header>
      <div class="toolkit">
        {SKILLS_IN_PRACTICE.map(group => (
          <article class="skill">
            <h3>{group.title}</h3><p>{group.description}</p>
            <ul class="tags">{group.skills.map(skill => <li>{skill}</li>)}</ul>
            <div class="proofs"><a href={group.proofHref}>{group.proofLabel} →</a>
              {group.secondaryProof && <a href={group.secondaryProof.href}>{group.secondaryProof.label} ↗</a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="open-source" aria-labelledby="source-heading"><div class="container">
    <header class="section-header"><h2 class="section-title" id="source-heading">Open source</h2></header>
    <div class="repos">{PUBLIC_CODE_SAMPLES.map(repo => <article>
      <p class="kicker">{repo.badge}</p>
      <h3><a href={repo.repoUrl}>{repo.name} <span aria-hidden="true">↗</span></a></h3>
      <p>{repo.description}</p><p>{repo.engineeringNote}</p>
      <ul class="tags">{repo.stack.map(tech => <li>{tech}</li>)}</ul>
    </article>)}</div>
  </div></section>

  <section class="section" id="education" aria-labelledby="education-heading"><div class="container split">
    <h2 class="section-title" id="education-heading">Education &amp;<br />recognition</h2>
    <div class="education">{EDUCATION_AND_RECOGNITION.map(item => <article>
      <p class="kicker">{item.period}</p><h3>{item.title}</h3><strong>{item.org}</strong><p>{item.detail}</p>
    </article>)}</div>
  </div></section>
</BaseLayout>

<style>
  .work { background:var(--surface-paper); }
  .section-title span,.story-title span { color:var(--orange); }
  .cases-grid,.toolkit { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:clamp(1rem,2vw,2rem); }
  .about { background:#e9e9df; }
  .split,.role-row { display:grid; grid-template-columns:minmax(0,.72fr) minmax(0,1.4fr); gap:clamp(1.2rem,4vw,4rem); }
  .side-heading { margin:.5rem 0; }
  .story-title { font-size:clamp(2.3rem,4.1vw,4rem); line-height:1.02; letter-spacing:-.065em; margin:0 0 1.4rem; font-weight:560; }
  .story { max-width:57ch; font-size:1.07rem; margin:.75rem 0 0; }
  .role-list,.education { border-bottom:1px solid var(--border-subtle); }
  .role-row,.education article { padding-block:1.6rem; border-top:1px solid var(--border-subtle); }
  .role-meta p { margin:0 0 .2rem; font-size:.82rem; }
  .role-meta span { font-size:.88rem; color:var(--ink-muted); }
  h3 { font-size:clamp(1.25rem,2vw,1.65rem); font-weight:600; line-height:1.2; letter-spacing:-.04em; margin:0; }
  .role-body>p,.skill p,.repos article>p:not(.kicker),.education article>p:last-child { color:var(--ink-muted); max-width:64ch; margin:.65rem 0; }
  .role-body .employer { color:var(--ink); font-weight:600; margin:.25rem 0; }
  summary { display:flex; align-items:center; justify-content:space-between; gap:1rem; cursor:pointer; min-height:44px; color:var(--teal); font-weight:600; font-size:.92rem; }
  summary::-webkit-details-marker { display:none; }
  summary span { display:grid; place-items:center; width:1.5rem; height:1.5rem; border-radius:50%; border:1px solid var(--border-subtle); }
  summary span::before { content:'+'; } details[open] summary span::before { content:'−'; }
  details ul { padding-left:1.15rem; } details li { margin:.5rem 0; }
  .related,.proofs { display:grid; justify-items:start; gap:.45rem; font-size:.88rem; }
  .skills { background:#e7ebe3; }
  .skill { display:flex; flex-direction:column; border-top:2px solid #767f72; padding-top:1rem; }
  .skill p,.repos article>p { font-size:.94rem; }
  .tags { display:flex; flex-wrap:wrap; align-items:start; gap:.35rem; list-style:none; padding:0; margin:.75rem 0 1rem; }
  .tags li { font:400 .73rem/1.45 var(--font-mono); padding:.2rem .45rem; border:1px solid #bec3b7; border-radius:3px; }
  .proofs { margin-top:auto; }
  .repos { display:grid; grid-template-columns:1fr 1fr; gap:clamp(1.5rem,4vw,4rem); }
  .repos article { border-top:1px solid var(--ink); padding-top:.85rem; }
  .repos h3 { font-size:clamp(1.6rem,2.5vw,2.25rem); }
  .repos h3 a { color:var(--ink); text-decoration:none; } .repos h3 a:hover { color:var(--orange); }
  .repos h3 span { font-size:.7em; }
  .education .kicker { margin:0 0 .5rem; }
  .education strong { display:block; margin-top:.4rem; }
  @media(max-width:760px) {
    .cases-grid,.toolkit,.split,.role-row,.repos { grid-template-columns:1fr; }
    .cases-grid { gap:0; } .role-row { gap:.6rem; }
    .role-meta { display:flex; flex-wrap:wrap; gap:.75rem; align-items:baseline; }
    .toolkit { gap:1.8rem; } .section-header { align-items:start; flex-direction:column; }
  }
</style>
